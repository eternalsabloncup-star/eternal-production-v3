# ETERNAL PRODUCTION V3 — local development example
# Copy to .env and replace placeholder values. Never commit real passwords.

APP_ENV=development
APP_DEBUG=true
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173

# Docker Compose PostgreSQL (local-only)
POSTGRES_DB=eternal_production_v3_dev
POSTGRES_USER=epv3_dev
POSTGRES_PASSWORD=replace_with_local_dev_password
POSTGRES_PORT=5432

# Backend async / sync database URLs (development)
DATABASE_URL=postgresql+asyncpg://epv3_dev:replace_with_local_dev_password@127.0.0.1:5432/eternal_production_v3_dev
DATABASE_URL_SYNC=postgresql+psycopg2://epv3_dev:replace_with_local_dev_password@127.0.0.1:5432/eternal_production_v3_dev
DATABASE_ECHO=false

# Dedicated automated test database (distinct credentials)
TEST_DATABASE_URL=postgresql+asyncpg://epv3_test:replace_with_local_test_password@127.0.0.1:5432/eternal_production_v3_test
TEST_DATABASE_URL_SYNC=postgresql+psycopg2://epv3_test:replace_with_local_test_password@127.0.0.1:5432/eternal_production_v3_test

# Frontend
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1
