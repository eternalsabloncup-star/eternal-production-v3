# ETERNAL PRODUCTION V3 — local development example
# Copy to .env and replace placeholder values. Never commit real passwords.

APP_ENV=development
APP_DEBUG=true
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173

# Docker Compose PostgreSQL (local-only)
POSTGRES_DB=eternal_production_v3_dev
POSTGRES_USER=epv3_dev
POSTGRES_PASSWORD=replace_with_local_dev_password
POSTGRES_PORT=5432

# Backend async / sync database URLs (development)
DATABASE_URL=postgresql+asyncpg://epv3_dev:replace_with_local_dev_password@127.0.0.1:5432/eternal_production_v3_dev
DATABASE_URL_SYNC=postgresql+psycopg2://epv3_dev:replace_with_local_dev_password@127.0.0.1:5432/eternal_production_v3_dev
DATABASE_ECHO=false

# Dedicated automated test database (distinct credentials)
TEST_DATABASE_URL=postgresql+asyncpg://epv3_test:replace_with_local_test_password@127.0.0.1:5432/eternal_production_v3_test
TEST_DATABASE_URL_SYNC=postgresql+psycopg2://epv3_test:replace_with_local_test_password@127.0.0.1:5432/eternal_production_v3_test

# Frontend — same-origin V3 by default. Optional absolute override must target V3 (:8100), never ERP V1 (:8000).
# Leave unset (or /api/v1) for same-origin; Vite dev proxies /api → http://127.0.0.1:8100
VITE_API_BASE_URL=/api/v1

# V3-only auth (NEVER copy ERP V1 JWT_SECRET)
# JWT signing key and password pepper MUST be different values.
V3_JWT_SECRET=replace_with_v3_jwt_secret
V3_PASSWORD_PEPPER=replace_with_v3_password_pepper
V3_JWT_HOURS=12

# Dedicated read-only Accurate gateway (NEVER paste human JWT / V1 Accurate creds)
# Same-host only: base URL has NO path prefix (client calls /sales-orders, /receipts/{id}, /delivery-notes/{id}).
# See docs/internal-gateway-url.md
V3_ACCURATE_READ_GATEWAY_URL=http://127.0.0.1:8091
V3_ACCURATE_READ_GATEWAY_TOKEN=replace_with_shared_m2m_token
# Force evidence checks in non-prod (staging dry-run)
V3_ACCURATE_EVIDENCE_ENFORCE=false
# Private POD attachment root (local FS only — never ERP V1 paths / public URLs)
V3_ATTACHMENT_ROOT=./backend/var/attachments

# accurate-gateway service (independent process — never ERP V1 secrets)
GATEWAY_M2M_TOKEN=replace_with_shared_m2m_token
# Local CI default = fixture. Live cutover / Phase 5 claims require GATEWAY_MODE=live (no fixture fallback).
GATEWAY_MODE=fixture
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8091
# Live Accurate Online API Token 1.0.3 (Owner-held; GATEWAY_MODE=live)
# Phase 5: fixture mode is forbidden for live verification claims.
# Never reuse a token that was exposed in chat/screenshots — revoke & replace.
ACCURATE_API_TOKEN=
ACCURATE_SIGNATURE_SECRET=
# Optional pin only — host/id normally from POST /api/api-token.do (not required)
ACCURATE_DATABASE_ID=
ACCURATE_ACCOUNT_BASE=https://account.accurate.id
# Optional Owner-supplied document ids for phase5_live_probe.py (never invent)
# PHASE5_LIVE_RECEIPT_ID=
# PHASE5_LIVE_SJ_ID=
# PHASE5_LIVE_CANCELLED_RECEIPT_ID=
# PHASE5_LIVE_CANCELLED_SJ_ID=

# Proposed production host (DNS/TLS Owner-managed)
# https://produksieternalpackaging.id
